{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-move-clip",
    "allow-create-project",
    "allow-save-project",
    "allow-open-project",
    "allow-add-track",
    "allow-add-clip",
    "allow-desktop-channel-ready"
  ]
}
